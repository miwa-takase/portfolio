# このファイルを .env.local にコピーして値を入れると、開発時に反映されます。
# 本番（GitHub Pages）は deploy ワークフローが Repository variables から注入します。

# Spotify（公開クライアント：Client ID のみ）
#   Redirect URI 登録（http は 127.0.0.1 のみ許可・localhost は不可）:
#   https://miwa-takase.github.io/works-portfolio/works/music-social
#   http://127.0.0.1:5173/works-portfolio/works/music-social
VITE_SPOTIFY_CLIENT_ID=

# AI系バックエンド（Cloudflare Worker）のベースURL。未設定ならサンプル表示。
# 例: https://works-portfolio-api.<your>.workers.dev
VITE_API_BASE=

# Cloudflare Turnstile サイトキー（公開値）。Worker の TURNSTILE_SECRET と対で使う。
VITE_TURNSTILE_SITEKEY=
